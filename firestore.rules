rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    // Checks if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Grabs the user's businessId from their user document
    function getUserBusinessId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
    }
    
    // Checks if the user belongs to the requested businessId
    function isBusinessStaff(targetBusinessId) {
      return isAuthenticated() && getUserBusinessId() == targetBusinessId;
    }

    // ==========================================
    // BUSINESS OVERSIGHT (ADMINS)
    // ==========================================
    
    // Users can read/write their own staff profile
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId; // Allow client provisioning
    }

    // Businesses
    match /businesses/{businessId} {
      allow read: if true; // Public needs this to view the booking page
      allow create: if isAuthenticated(); // Allow client provisioning
      allow update, delete: if isBusinessStaff(businessId);
    }
    
    // Services & Availability
    match /services/{serviceId} {
      allow read: if true; // Public needs to see what they can book
      allow create: if isBusinessStaff(request.resource.data.businessId);
      allow update, delete: if isBusinessStaff(resource.data.businessId);
    }
    match /availability/{availId} {
      allow read: if true; // Public needs to see available hours
      allow create: if isBusinessStaff(request.resource.data.businessId);
      allow update, delete: if isBusinessStaff(resource.data.businessId);
    }

    // ==========================================
    // TRANSACTIONAL DATA (APPOINTMENTS)
    // ==========================================
    
    match /appointments/{appointmentId} {
      // 1. Staff can do everything for their business
      allow read, update, delete: if isBusinessStaff(resource.data.businessId);
      
      // 2. Public can create, BUT we enforce severe restrictions so they can't spoof data
      allow create: if true 
        && request.resource.data.keys().hasAll(['businessId', 'customerId', 'serviceId', 'startTime', 'endTime', 'status'])
        && request.resource.data.status == 'booked'
        && request.resource.data.reminderSent == false;
    }
    
    match /customers/{customerId} {
      // Never allow public read! Massively vulnerable to PII scraping.
      allow read, update, delete: if isBusinessStaff(resource.data.businessId);
      allow create: if true; // Public can create themselves when booking
    }
  }
}
