rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    // Checks if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Grabs the user's businessId safely without throwing Null evaluation errors
    function getUserBusinessId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId
        : null;
    }
    
    // Checks if the user belongs to the requested businessId
    function isBusinessStaff(targetBusinessId) {
      return isAuthenticated() && getUserBusinessId() == targetBusinessId;
    }

    // ==========================================
    // BUSINESS OVERSIGHT (ADMINS)
    // ==========================================
    
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /businesses/{businessId} {
      allow read: if true; 
      allow create: if isAuthenticated(); 
      allow update, delete: if isBusinessStaff(businessId);
    }
    
    match /services/{serviceId} {
      allow read: if true; 
      allow create: if isBusinessStaff(request.resource.data.businessId);
      allow update, delete: if isBusinessStaff(resource.data.businessId);
    }
    match /availability/{availId} {
      allow read: if true; 
      allow create: if isBusinessStaff(request.resource.data.businessId);
      allow update, delete: if isBusinessStaff(resource.data.businessId);
    }

    // ==========================================
    // TRANSACTIONAL DATA (APPOINTMENTS)
    // ==========================================
    
    match /appointments/{appointmentId} {
      // 1. Staff can do everything for their business
      allow read, update, delete: if isBusinessStaff(resource.data.businessId);
      
      // 2. Allow Admins to securely create
      allow create: if isBusinessStaff(request.resource.data.businessId);

      // 3. Allow Public to create (Safe fallback for now, Phase 4 will use Cloud Functions)
      allow create: if true 
        && request.resource.data.status == 'booked'
        && request.resource.data.reminderSent == false
        && request.resource.data.keys().hasAll(['businessId', 'customerId', 'serviceId', 'dateString', 'startTime', 'status']);
    }
    
    match /customers/{customerId} {
      allow read, update, delete: if isBusinessStaff(resource.data.businessId);
      allow create: if true;
    }
  }
}
